# Copie para ".env" e ajuste. Tudo é opcional para rodar localmente.

# Porta HTTP (o Render define PORT sozinho)
PORT=3000
# Porta HTTPS local (certificado autoassinado) para testar o celular na rede Wi-Fi
HTTPS_PORT=3443
# 0 desliga o HTTPS local (ex.: se você usa um túnel como cloudflared/ngrok)
DEV_HTTPS=1
# Endereço público usado no QR code (ex.: o link do túnel https://xxxx.trycloudflare.com)
PUBLIC_URL=

# Produção
NODE_ENV=development
# Domínios do front-end autorizados a chamar a API (separe por vírgula). Ex.: https://go-sports.vercel.app
CLIENT_ORIGIN=*
# Banco Postgres (Neon, Supabase, Render). Vazio = SQLite local em data/gosports.db
DATABASE_URL=
SQLITE_FILE=
# Tempo (ms) procurando adversário online antes de chamar o bot reserva
MM_TIMEOUT_MS=8000
